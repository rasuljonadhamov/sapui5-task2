<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="confirmDeleteDialog" type="Message" title="{i18n>deleteDialogTitle}">
        <Text text="{i18n>deleteDialogText}" class="sapUiTinyMargin"/>
        <beginButton>
            <Button text="{i18n>yesButton}" type="Emphasized" press=".onConfirmDelete"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>noButton}" press=".onCancelDelete"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
